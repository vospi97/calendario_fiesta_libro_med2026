DTSTART;TZID=America/Bogota:20260920T150000
DTEND;TZID=America/Bogota:20260920T160000
SUMMARY:Las vidas que contamos
DESCRIPTION:\\n\\nFuente: Programación Fiesta del Libro y la Cultura 2026\, pág. 106.
END:VEVENT
